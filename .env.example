# ---- required in production
DATABASE_URL=postgresql+psycopg://auditor:CHANGE_ME@localhost:5432/auditor
API_TOKEN=                        # long random string; required for any non-local deployment
PROJECTS_FILE=./deploy/projects.json

# ---- model (without a key a deterministic stand-in is used and every run says so)
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-opus-5-5
FIX_MODEL=claude-opus-5-5
SEND_SCREENSHOTS_TO_MODEL=false   # privacy: screenshots only leave the machine if you turn this on

# ---- hardening (defaults shown)
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
ALLOW_CUSTOM_RUNS=false           # NEVER enable on a shared server: lets API callers run arbitrary commands
DEMO_ENABLED=true
ENABLE_DOCS=false
MAX_CONCURRENT_RUNS=1
RUN_TIMEOUT_S=3600
MODEL_TOKEN_BUDGET=1500000        # hard ceiling on model tokens per run
MAX_FINDINGS_PER_PAGE=200
MAX_REQUEST_BYTES=65536
REFUSAL_FALLBACK=true             # retry a declined request on a fallback model
EVIDENCE_DIR=./evidence

# ---- web app (frontend/.env.local or the container environment)
API_INTERNAL_URL=http://127.0.0.1:8000
AUDITOR_API_TOKEN=                # same value as API_TOKEN; stays on the server, never sent to browsers
UI_BASIC_AUTH=                    # optional user:password gate; prefer SSO at your reverse proxy
